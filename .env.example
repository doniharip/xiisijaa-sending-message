# ============================================================
# SECRET NOTES — Environment Variables
# Salin file ini menjadi .env dan isi nilainya
# JANGAN commit file .env ke git!
# ============================================================

# Server
PORT=3000
NODE_ENV=production
FRONTEND_URL=https://your-app.railway.app

# Database MySQL (Railway otomatis mengisi ini)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=ganti_password_database_kamu
DB_NAME=secret_notes

# JWT Secret — ganti dengan string random panjang!
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=ganti_dengan_string_random_sangat_panjang_minimal_64_karakter

# Admin password
ADMIN_PASSWORD=ganti_password_admin_kamu

# Google Drive Backup
# Folder ID dari URL Google Drive: drive.google.com/drive/folders/FOLDER_ID_INI
GDRIVE_FOLDER_ID=id_folder_google_drive_kamu
